    <string name="privacy_introduction">%1$s menghormati privasi Anda dan hanya memproses informasi yang diperlukan untuk menyediakan jadwal sholat, pengingat, preferensi aplikasi, dan performa aplikasi yang andal.</string>

    <string name="information_we_process">Informasi yang Kami Proses</string>

    <string name="location_data">Data Lokasi</string>
    <string name="location_data_privacy_description">Lokasi perangkat yang tepat atau perkiraan digunakan untuk meminta jadwal sholat. Koordinat dikirim ke Aladhan API saat sinkronisasi jadwal dilakukan.</string>

    <string name="application_preferences">Preferensi Aplikasi</string>
    <string name="application_preferences_privacy_description">Metode perhitungan, mazhab Asar, bahasa, status pengingat, dan waktu pengingat disimpan secara lokal di perangkat Anda.</string>

    <string name="personal_schedule_data">Data Jadwal Pribadi</string>
    <string name="personal_schedule_data_description">Judul jadwal, tanggal, waktu, dan preferensi pengingat yang Anda buat disimpan secara lokal di perangkat Anda.</string>

    <string name="diagnostic_performance_data">Data Diagnostik &amp; Performa</string>
    <string name="diagnostic_performance_data_description">Firebase dapat memproses laporan kerusakan, status aplikasi, metadata perangkat, pengidentifikasi instalasi, metrik performa, dan waktu jaringan untuk membantu meningkatkan stabilitas aplikasi.</string>

    <string name="how_we_use_information">Cara Kami Menggunakan Informasi</string>
    <string name="use_location_for_prayer_schedule">Meminta jadwal sholat dari Aladhan berdasarkan lokasi perangkat Anda.</string>
    <string name="use_local_application_data">Menyimpan jadwal sholat, jadwal pribadi, dan preferensi aplikasi secara lokal.</string>
    <string name="use_data_for_reminders">Menjadwalkan alarm sholat, notifikasi, dan pengingat jadwal pribadi.</string>
    <string name="use_diagnostic_data">Mengidentifikasi kerusakan dan memantau performa aplikasi melalui Firebase.</string>

    <string name="data_storage_and_security">Penyimpanan &amp; Keamanan Data</string>
    <string name="data_storage_and_security_description">Jadwal sholat, jadwal pribadi, dan preferensi aplikasi disimpan secara lokal di perangkat Anda. Koordinat lokasi dikirim ke Aladhan hanya saat jadwal sholat disinkronkan. Firebase dapat memproses data diagnostik dan performa teknis di infrastruktur Google. Aplikasi tidak menyediakan akun pengguna atau menyimpan data pribadi Anda di backend yang dioperasikan pengembang.</string>

